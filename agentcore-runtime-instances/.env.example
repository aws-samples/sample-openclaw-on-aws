# AWS Configuration
# AWS_REGION — The region to deploy into.
# Supported regions for AgentCore Runtime Instances:
#   us-east-1, us-east-2, us-west-2,
#   ap-south-1, ap-southeast-1, ap-southeast-2, ap-northeast-1,
#   eu-central-1, eu-west-1
AWS_REGION=us-east-1

# S3 Backup (set by deploy script automatically, or override)
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=workspace

# Sync interval for background S3 backup (seconds)
SYNC_INTERVAL=300

# OpenClaw Gateway
OPENCLAW_PORT=18789
OPENCLAW_GATEWAY_TOKEN=

# AgentCore
AGENTCORE_PORT=8080

# Capacity Provider (set after first deploy)
CAPACITY_PROVIDER_ARN=
AGENT_RUNTIME_ID=
