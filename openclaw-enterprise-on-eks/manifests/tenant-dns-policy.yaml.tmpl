apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: openclaw-auto-mode-dns
  namespace: __TENANT_NAMESPACE__
spec:
  podSelector: {}
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: __NODE_LOCAL_DNS_IP__/32
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
