RUNTIME_IMAGE=111122223333.dkr.ecr.us-east-1.amazonaws.com/openclaw-enterprise/runtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

