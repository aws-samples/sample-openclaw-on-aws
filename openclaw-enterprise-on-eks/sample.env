# Copy to .env and replace the values for your account.
AWS_REGION=us-east-1
CLUSTER_NAME=oce-auto-mode
KUBERNETES_VERSION=1.35
PUBLIC_ACCESS_CIDR=203.0.113.10/32

# Pin the OCE source used to build the images and install the chart.
OCE_GIT_REF=8c02880a0d64ae7576896cec22b136ac8ac5587e # pragma: allowlist secret
OCE_SOURCE_DIR=../../openclaw-enterprise

# Use immutable private ECR image references.
CONTROLLER_IMAGE=111122223333.dkr.ecr.us-east-1.amazonaws.com/openclaw-enterprise/controller@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
RUNTIME_IMAGE=111122223333.dkr.ecr.us-east-1.amazonaws.com/openclaw-enterprise/runtime@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Optional build-and-publish overrides.
ECR_CONTROLLER_REPOSITORY=openclaw-enterprise/controller
ECR_RUNTIME_REPOSITORY=openclaw-enterprise/runtime
OCE_IMAGE_PLATFORM=linux/arm64
# backup-postgres-dev.sh creates a permission-restricted plaintext custom-format
# pg_dump and checks its archive catalog with pg_restore --list.
# Optional: upload PostgreSQL backups to an existing S3 URI ending in /.
# The helper requires the expected bucket owner and an AWS KMS key.
# The upload uses SSE-KMS, refuses overwrite, then checks size and encryption.
# It does not add automatic failover, point-in-time recovery, or a validated
# full restore.
# POSTGRES_BACKUP_S3_URI=s3://your-backup-bucket/openclaw-enterprise/
# POSTGRES_BACKUP_S3_EXPECTED_BUCKET_OWNER=111122223333
# POSTGRES_BACKUP_KMS_KEY_ID=alias/your-backup-key

MODEL_ID=global.openai.gpt-5.6-sol
OCE_NAMESPACE=openclaw-system
OCE_RELEASE=oce
